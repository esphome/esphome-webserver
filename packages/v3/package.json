{
  "name": "@esphome-webserver/v3",
  "version": "3.0.0",
  "type": "module",
  "scripts": {
    "start": "npm run dev",
    "dev": "vite",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "xbuild": "vite build --emptyOutDir",
    "build": "vite build --emptyOutDir && npm run deploy",
    "serve": "vite preview",
    "deploy": "bash -c '../../scripts/make_header.sh ../../_static/v3 server_index_v3.h web_server 3'"
  },
  "dependencies": {
    "iconify-icon": "^3.0.2",
    "lit": "^3.3.3"
  },
  "devDependencies": {
    "@rollup/plugin-replace": "^6.0.3",
    "@types/node": "^26.1.2",
    "rollup-plugin-strip-banner": "^3.1.0",
    "typescript": "^7.0.2",
    "vite": "^8.1.5",
    "vite-plugin-package-version": "^1.1.0",
    "vite-plugin-singlefile": "^2.3.3"
  }
}
