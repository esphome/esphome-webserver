{
  "name": "@esphome-webserver/v4",
  "version": "4.0.0",
  "type": "module",
  "scripts": {
    "start": "npm run dev",
    "dev": "vite",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "icons": "tsx scripts/gen-icons.ts",
    "build": "vite build --emptyOutDir && npm run size && npm run deploy",
    "size": "node scripts/size-check.mjs",
    "serve": "vite preview",
    "deploy": "bash -c '../../scripts/make_header.sh ../../_static/v4 server_index_v4.h web_server 4'"
  },
  "devDependencies": {
    "@rollup/plugin-replace": "^6.0.3",
    "@types/node": "^26.2.0",
    "rollup-plugin-strip-banner": "^3.1.0",
    "tsx": "^4.19.2",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vite-plugin-package-version": "^1.1.0",
    "vite-plugin-singlefile": "^2.3.3"
  }
}
